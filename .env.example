# Copiez ce fichier en .env.local et adaptez les valeurs.

# Chemin utilisé par le navigateur pour appeler l'API. Toujours un chemin
# relatif ("/api"), en local comme en production : c'est next.config.js
# (rewrite) qui se charge de le relayer vers la vraie API, ce qui permet au
# cookie de connexion d'être posé sur le domaine du frontend plutôt que
# sur celui de l'API. Ne mettez jamais ici l'URL complète de l'API.
NEXT_PUBLIC_API_URL=/api

# Destination réelle de l'API, utilisée uniquement côté serveur (jamais
# envoyée au navigateur) : par next.config.js pour le rewrite ci-dessus, et
# par proxy.ts pour vérifier qui est connecté avant d'autoriser l'accès à
# /plateforme et /admin.
# En local : http://localhost:3001/api (valeur par défaut si absent).
# En production (Vercel) : l'URL publique de votre API Render, suivie de
# /api — ex. https://germe-cameroun-api-xxxx.onrender.com/api
API_INTERNAL_URL=http://localhost:3001/api
